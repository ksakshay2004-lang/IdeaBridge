# ---- Core -------------------------------------------------------------
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"  (REQUIRED, 32+ chars, in production)
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+psycopg://ideabridge:ideabridge@localhost:5432/ideabridge
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=720
AUTO_CREATE_TABLES=true

# ---- Uploads ----------------------------------------------------------
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_MB=10

# ---- First admin / demo data -----------------------------------------
# Creates an admin on start-up if both are set (password: 8+ chars; use a strong one).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Seeds sample users/ideas into an EMPTY database. Demo password: Demo@12345. Never enable in production.
SEED_DEMO_DATA=true

# ---- AI: leave keys empty to run in clearly-labelled DEMO MODE --------
# LLM for the evaluation report: none | anthropic | openai
LLM_PROVIDER=none
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Embeddings: local (offline, lexical) | openai (semantic; uses OPENAI_API_KEY, 384 dims)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384

# Optional external research retrieval (arXiv public API, no key): none | arxiv
EXTERNAL_RETRIEVAL=none
